+use crate::database::Database;
+use hbb_common::{log, sodiumoxide::crypto::sign, tokio, ResultType};
+use serde_json::json;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+pub(crate) struct Event {
+    pub sequence: i64,
+    pub guid: Vec<u8>,
+    pub uuid: Vec<u8>,
+    pub old_id: String,
+    pub new_id: String,
+    pub revision: i64,
+}
+
+fn now() -> i64 { SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_secs() as i64 }
+
+pub(crate) fn start(db: Database, key: Option<sign::SecretKey>) {
+    if std::env::var("NNU_ENABLE_CUSTOM_ID").as_deref() != Ok("Y") { return; }
+    let url = std::env::var("NNU_API_SYNC_URL").unwrap_or_default();
+    if url.is_empty() { log::warn!("API ID synchronization is unconfigured; events remain queued"); return; }
+    let key = match key { Some(key) => key, None => { log::error!("API ID synchronization requires the server signing key"); return; } };
+    let client = match reqwest::Client::builder().timeout(Duration::from_secs(5))
+        .redirect(reqwest::redirect::Policy::none()).build() {
+        Ok(client) => client, Err(_) => { log::error!("Unable to initialize API ID synchronization"); return; }
+    };
+    tokio::spawn(async move {
+        let mut timer = tokio::time::interval(Duration::from_secs(3));
+        loop {
+            timer.tick().await;
+            let events = match db.pending_id_events(now()).await {
+                Ok(events) => events,
+                Err(_) => { log::error!("Unable to read pending ID synchronization events"); continue; }
+            };
+            for event in events {
+                let error = deliver(&client, &url, &key, &event).await.err().map(|e| e.to_string());
+                if db.finish_id_event(event.sequence,now(),error.as_deref()).await.is_err() {
+                    log::error!("Unable to persist ID synchronization acknowledgement");
+                }
+                if error.is_some() { log::warn!("ID synchronization event {} remains queued for retry",event.sequence); }
+            }
+        }
+    });
+}
+
+async fn deliver(client: &reqwest::Client, url: &str, key: &sign::SecretKey, event: &Event) -> ResultType<()> {
+    let guid = base64::encode(&event.guid);
+    let payload = serde_json::to_vec(&json!({"schema":1,"type":"nnu-id-change","guid":guid,
+        "uuid":base64::encode(&event.uuid),"old_id":event.old_id,"new_id":event.new_id,
+        "revision":event.revision,"issued_at":now()}))?;
+    let mut message = b"NNU-ID-SYNC-V1\0".to_vec(); message.extend_from_slice(&payload);
+    let signature = sign::sign_detached(&message,key);
+    let reply = client.post(url).json(&json!({"payload":base64::encode(payload),
+        "signature":base64::encode(signature.to_bytes())})).send().await?;
+    if reply.status() != reqwest::StatusCode::OK { hbb_common::bail!("API returned HTTP {}",reply.status()); }
+    let ack: serde_json::Value = reply.json().await?;
+    if ack["ok"] != true || ack["guid"] != guid || ack["revision"] != event.revision || ack["id"] != event.new_id {
+        hbb_common::bail!("API acknowledgement mismatch");
+    }
+    Ok(())
+}
