+use crate::peer::PeerMap;
+use hbb_common::{rendezvous_proto::{register_pk_response::Result as Reply, RegisterPk}, sodiumoxide::crypto::sign};
+
+pub(crate) async fn change_id(pm: &PeerMap, request: RegisterPk) -> Reply {
+    if std::env::var("NNU_ENABLE_CUSTOM_ID").as_deref() != Ok("Y") { return Reply::NOT_SUPPORT; }
+    let id = request.id.as_bytes();
+    if !(6..=16).contains(&id.len()) || !id.first().map(u8::is_ascii_alphabetic).unwrap_or(false)
+        || !id.iter().all(|c| c.is_ascii_alphanumeric() || *c == b'_' || *c == b'-') {
+        return Reply::INVALID_ID_FORMAT;
+    }
+    if request.old_id.is_empty() || request.old_id.len() > 100 || request.uuid.is_empty()
+        || request.uuid.len() > 128 || request.pk.len() != 72 { return Reply::UUID_MISMATCH; }
+    let timestamp = u64::from_le_bytes(match request.pk[..8].try_into() { Ok(x) => x, Err(_) => return Reply::UUID_MISMATCH });
+    let now = match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {
+        Ok(time) => time.as_secs(), Err(_) => return Reply::SERVER_ERROR,
+    };
+    if now.abs_diff(timestamp) > 60 { return Reply::UUID_MISMATCH; }
+    let peer = match pm.get(&request.old_id).await { Some(peer) => peer, None => return Reply::UUID_MISMATCH };
+    let (pk, uuid) = { let p = peer.read().await; (p.pk.clone(), p.uuid.clone()) };
+    if uuid != request.uuid { return Reply::UUID_MISMATCH; }
+    let key = match sign::PublicKey::from_slice(&pk) { Some(key) => key, None => return Reply::UUID_MISMATCH };
+    let signature = match sign::Signature::from_bytes(&request.pk[8..]) { Ok(value) => value, Err(_) => return Reply::UUID_MISMATCH };
+    let mut message = b"NNU-ID-CHANGE-V1\0".to_vec();
+    for part in [request.old_id.as_bytes(), request.id.as_bytes(), request.uuid.as_ref()] {
+        message.extend_from_slice(&(part.len() as u32).to_le_bytes()); message.extend_from_slice(part);
+    }
+    message.extend_from_slice(&timestamp.to_le_bytes());
+    if !sign::verify_detached(&signature, &message, &key) { return Reply::UUID_MISMATCH; }
+    if request.id == request.old_id { return Reply::OK; }
+    match pm.db.rename_peer(&request.old_id, &request.id, &uuid, &pk, now as i64).await {
+        Ok(Reply::OK) => { pm.rename_cached(&request.old_id, &request.id, peer).await; Reply::OK }
+        Ok(reply) => reply,
+        Err(_) => Reply::SERVER_ERROR,
+    }
+}
