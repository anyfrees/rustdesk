+pub(crate) fn is_public_key_alias(candidate: &str) -> bool {
+    match std::env::var("NNU_PUBLIC_KEY_ALIAS") {
+        Ok(alias) if !alias.is_empty() && candidate == alias => base64::decode(alias)
+            .map(|key| key.len() == sign::PUBLICKEYBYTES)
+            .unwrap_or(false),
+        _ => false,
+    }
+}
 
